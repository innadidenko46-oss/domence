# Build variables. On Vercel set them in Project Settings → Environment Variables;
# locally copy this file to .env.local. Vite only exposes names that start with VITE_.

# Where the enquiry form sends leads. Without it the form shows a ready e-mail for the
# visitor to send themselves, and many phones have no mail app set up.
#   Web3Forms:  VITE_FORM_ENDPOINT="https://api.web3forms.com/submit"
#               VITE_FORM_ACCESS_KEY="<klucz z web3forms.com>"
#   Formspree:  VITE_FORM_ENDPOINT="https://formspree.io/f/<id-formularza>"
# Another service also works: add its domain to connect-src in vercel.json.
VITE_FORM_ENDPOINT=""
VITE_FORM_ACCESS_KEY=""

# Visit statistics without cookies (plausible.io). Empty = off.
# The domain added in Plausible, e.g. "domence.pl".
VITE_PLAUSIBLE_DOMAIN=""

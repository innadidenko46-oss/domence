# Klucz API Gemini (opcjonalny – potrzebny tylko jeśli backend używa funkcji AI).
GEMINI_API_KEY=""

# Publiczny adres URL aplikacji.
APP_URL=""

# Wysyłka formularzy (ankieta i kontakt). Bez tych zmiennych formularze otwierają
# program pocztowy odwiedzającego (mailto:). Po podłączeniu serwisu formularzy
# zgłoszenia wysyłają się bezpośrednio.
#   Formspree:  VITE_FORM_ENDPOINT="https://formspree.io/f/<id-formularza>"
#   Web3Forms:  VITE_FORM_ENDPOINT="https://api.web3forms.com/submit"
#               VITE_FORM_ACCESS_KEY="<klucz>"
VITE_FORM_ENDPOINT=""
VITE_FORM_ACCESS_KEY=""
